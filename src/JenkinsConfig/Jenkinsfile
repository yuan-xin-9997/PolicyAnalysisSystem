pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    triggers {
        pollSCM('H/30 * * * *')
    }

    environment {
        DEPLOY_ROOT = '/opt'
        APP_NAME = 'PolicyAnalysisSystem'
        APP_HOST = '0.0.0.0'
        APP_PORT = '30080'
        PYTHON_BIN = 'python3.12'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify') {
            options {
                timeout(time: 20, unit: 'MINUTES')
            }
            steps {
                sh '''
                    set -eu
                    if [ ! -d .venv ]; then
                        "${PYTHON_BIN}" -m venv .venv
                    fi
                    .venv/bin/pip install --timeout 30 --retries 5 -e '.[dev]'
                    npm --prefix src/app/frontend ci

                    .venv/bin/pytest -q
                    .venv/bin/ruff check src/app/backend src/tests/backend
                    .venv/bin/ruff format --check src/app/backend src/tests/backend
                    npm --prefix src/app/frontend run type-check
                    npm --prefix src/app/frontend run lint
                    npm --prefix src/app/frontend run test -- --run
                    npm --prefix src/app/frontend run build
                '''
            }
        }

        stage('Backup and check active tasks') {
            steps {
                sh '''
                    set -eu
                    DEPLOY_DIR="${DEPLOY_ROOT}/${APP_NAME}"
                    "${WORKSPACE}/.venv/bin/python" "${WORKSPACE}/scripts/deployment.py" preflight --root "${DEPLOY_DIR}"
                '''
            }
        }

        stage('Stop current service') {
            steps {
                sh '''
                    set -eu
                    DEPLOY_DIR="${DEPLOY_ROOT}/${APP_NAME}"
                    sudo -n /usr/bin/systemctl stop policy-analysis.service
                    if systemctl is-active --quiet policy-analysis.service; then
                        exit 1
                    fi
                '''
            }
        }

        stage('Update deployment files') {
            steps {
                sh '''
                    set -eu
                    DEPLOY_DIR="${DEPLOY_ROOT}/${APP_NAME}"
                    mkdir -p "${DEPLOY_DIR}"

                    rsync -a --delete \
                        --exclude '.git/' \
                        --exclude '.venv/' \
                        --exclude 'service.env' \
                        --exclude 'src/config/app.json' \
                        --exclude 'src/data/' \
                        --exclude 'src/logs/' \
                        "${WORKSPACE}/" "${DEPLOY_DIR}/"

                    mkdir -p "${DEPLOY_DIR}/src/config" "${DEPLOY_DIR}/src/data" "${DEPLOY_DIR}/src/logs"
                    if [ ! -f "${DEPLOY_DIR}/src/config/app.json" ]; then
                        cp "${WORKSPACE}/src/config/app.json" "${DEPLOY_DIR}/src/config/app.json"
                    fi
                    if [ ! -f "${DEPLOY_DIR}/src/data/password.txt" ]; then
                        cat > "${DEPLOY_DIR}/src/data/password.txt" <<'EOF'
# 格式: username:password:role  (role 取值: admin | user)
# admin 默认拥有所有页面权限；user 的可见页面由管理员在权限管理页配置。
# 修改本文件后，新用户在下次登录时会自动同步到数据库。
admin:admin123:admin
EOF
                        chmod 600 "${DEPLOY_DIR}/src/data/password.txt"
                    fi
                '''
            }
        }

        stage('Install and build') {
            options {
                timeout(time: 20, unit: 'MINUTES')
            }
            steps {
                sh '''
                    set -eu
                    DEPLOY_DIR="${DEPLOY_ROOT}/${APP_NAME}"
                    cd "${DEPLOY_DIR}"

                    if [ ! -d .venv ]; then
                        "${PYTHON_BIN}" -m venv .venv
                    fi
                    .venv/bin/pip install --timeout 30 --retries 5 --upgrade pip
                    .venv/bin/pip install --timeout 30 --retries 5 -e .

                    npm --prefix src/app/frontend ci
                    npm --prefix src/app/frontend run build
                    .venv/bin/python scripts/deployment.py migrate
                '''
            }
        }

        stage('Start service') {
            steps {
                sh '''
                    set -eu
                    DEPLOY_DIR="${DEPLOY_ROOT}/${APP_NAME}"
                    cd "${DEPLOY_DIR}"
                    sudo -n /usr/bin/systemctl start policy-analysis.service
                    for attempt in $(seq 1 30); do
                        if systemctl is-active --quiet policy-analysis.service && \
                            curl -fsS "http://127.0.0.1:${APP_PORT}/health/ready"; then
                            exit 0
                        fi
                        sleep 1
                    done
                    systemctl status policy-analysis.service --no-pager || true
                    exit 1
                '''
            }
        }
    }

    post {
        success {
            sh '''
                set -eu
                DEPLOY_DIR="${DEPLOY_ROOT}/${APP_NAME}"
                cd "${DEPLOY_DIR}"
                .venv/bin/python scripts/verify_ai_access.py --from-password-file
            '''
        }
        always {
            sh '''
                set +e
                DEPLOY_DIR="${DEPLOY_ROOT}/${APP_NAME}"
                if [ -f "${DEPLOY_DIR}/src/logs/app.log" ]; then
                    tail -n 100 "${DEPLOY_DIR}/src/logs/app.log"
                fi
            '''
        }
    }
}
